rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Master catalog courses: readable by all students, writeable by staff
    match /courses/{courseId} {
      allow read, write: if true;
    }

    // Student repeat course registrations: students can register and query their registration status
    match /registrations/{registrationId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'nama', 'nim', 'email', 'selectedCourses', 'totalSks', 'status']);
      allow update, delete: if true;
    }

    // Academic & fee configuration: can be updated by management
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Credentialed system user accounts
    match /system_users/{userId} {
      allow read, write: if true;
    }
  }
}
